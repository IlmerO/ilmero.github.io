---
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].about;
---
<h1 class="visually-hidden">{t.title}</h1>

<div class="bio prose">
  <img class="portrait" src="/images/ilmer.webp" alt={t.photoAlt} width="720" height="900" loading="eager" />
  {t.bio.map((p) => <p>{p}</p>)}
</div>

<section class="section">
  <h2>{t.expTitle}</h2>
  <p class="hint">{t.expHint}</p>
  <div class="jobs">
    {t.jobs.map((j, i) => (
      <details class="job" open={i === 0}>
        <summary>
          <span class="toggle" aria-hidden="true"></span>
          <span class="head">
            <span class="role">{j.role}, {j.org}</span>
            <span class="when">{j.period}, {j.place}</span>
          </span>
        </summary>
        <div class="job-body">
          <p class="job-intro">{j.intro}</p>
          <ul>
            {j.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <p class="job-stack"><span>Stack:</span> {j.stack}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<section class="section">
  <h2>{t.eduTitle}</h2>
  <ul class="edu">
    {t.edu.map((e) => (
      <li><h3>{e.t}</h3><p>{e.s}</p><p class="muted">{e.period}</p></li>
    ))}
  </ul>
</section>

<section class="section">
  <h2>{t.langTitle}</h2>
  <table class="lang-table">
    <tbody>
      {t.langs.map((l) => <tr><th scope="row">{l.name}</th><td>{l.level}</td></tr>)}
    </tbody>
  </table>
</section>

<style>
  .bio { margin-top: 0; }
  .section { margin-top: 2rem; }
  .section > h2 { color: var(--red-text); font-style: italic; font-size: 0.9375rem; margin-bottom: 0.5rem; }
  .edu h3 { font-size: 0.8125rem; color: var(--teal); }
  .bio::after { content: ''; display: block; clear: both; }
  .portrait {
    float: right; width: 10.5rem; height: auto; margin: 0.3rem 0 1rem 1.5rem;
    border: 1px solid #000;
  }
  @media (max-width: 36rem) { .portrait { width: 8rem; margin-left: 1rem; } }

  .hint { font-size: 0.6875rem; font-style: italic; color: var(--grey); margin: 0 0 0.5rem; }
  .jobs { max-width: var(--measure); border-top: 1px dashed var(--red-text); }
  .job { border-bottom: 1px dashed var(--red-text); }
  .job summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: flex-start; gap: 0.6rem; padding: 0.65rem 0;
  }
  .job summary::-webkit-details-marker { display: none; }
  .toggle {
    flex: none; width: 13px; height: 13px; margin-top: 0.3rem;
    border: 1px solid #000; position: relative; background: #fff;
  }
  .toggle::before, .toggle::after { content: ''; position: absolute; background: var(--ink); }
  .toggle::before { left: 2px; right: 2px; top: 5px; height: 1px; }
  .toggle::after { top: 2px; bottom: 2px; left: 5px; width: 1px; }
  .job[open] .toggle::after { display: none; }
  .head { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .role { font-weight: 700; font-size: 0.875rem; color: var(--teal); text-decoration: underline; text-underline-offset: 0.12em; }
  .job summary:hover .role { color: var(--red); }
  .when { font-size: 0.6875rem; font-style: italic; color: var(--grey); }
  .job-body { padding: 0 0 1.1rem 1.4rem; }
  .job-intro { font-style: italic; color: var(--red-text); margin-bottom: 0.5rem; }
  .job-body ul { margin: 0; padding-left: 1.1rem; font-size: 0.8125rem; }
  .job-body li + li { margin-top: 0.4rem; }
  .job-stack { margin-top: 0.6rem; font-size: 0.75rem; }
  .job-stack span { color: var(--red-text); font-weight: 700; }

  .edu { list-style: none; margin: 0; padding: 0; max-width: var(--measure); }
  .edu li + li { margin-top: 1rem; }
  .edu h3 { margin-bottom: 0.15rem; }

  .lang-table { border-collapse: collapse; font-size: 0.8125rem; }
  .lang-table th, .lang-table td { border: 1px solid #999; padding: 0.2rem 0.9rem 0.2rem 0.5rem; text-align: left; }
  .lang-table th { font-weight: 400; background: #f0f0f0; }
</style>
