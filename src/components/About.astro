---
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].about;
---
<div class="about">
  <header class="page-head">
    <h1>{t.title}</h1>
  </header>

  <div class="intro">
    <div class="prose">
      {t.bio.map((p) => <p>{p}</p>)}
    </div>
    <img src="/images/ilmer.webp" alt={t.photoAlt} width="720" height="900" loading="eager" />
  </div>

  <section class="section">
    <h2>{t.expTitle}</h2>
    <ol class="timeline">
      {t.jobs.map((j) => (
        <li>
          <p class="period">{j.period}</p>
          <div>
            <h3>{j.role}, {j.org}</h3>
            <p class="place">{j.place}</p>
            <p class="job-note">{j.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <div class="two">
    <section class="section">
      <h2>{t.eduTitle}</h2>
      <ul class="plain">
        {t.edu.map((e) => (
          <li><h3>{e.t}</h3><p class="muted">{e.s}</p><p class="muted small">{e.period}</p></li>
        ))}
      </ul>
    </section>
    <section class="section">
      <h2>{t.langTitle}</h2>
      <table class="lang-table">
        <tbody>
          {t.langs.map((l) => <tr><th scope="row">{l.name}</th><td>{l.level}</td></tr>)}
        </tbody>
      </table>
    </section>
  </div>
</div>

<style>
  .intro { display: grid; gap: 2.5rem; margin-top: 2rem; align-items: start; }
  @media (min-width: 52rem) { .intro { grid-template-columns: minmax(0, 1fr) 15rem; gap: 4rem; } }
  img { width: 100%; max-width: 15rem; height: auto; border-radius: 4px; filter: saturate(0.85); }

  .timeline { list-style: none; margin: 0; padding: 0; max-width: 46rem; }
  .timeline li {
    display: grid; grid-template-columns: 1fr; gap: 0.25rem 2rem;
    padding: 1.1rem 0; border-top: 1px solid var(--rule);
  }
  .timeline li:last-child { border-bottom: 1px solid var(--rule); }
  @media (min-width: 40rem) { .timeline li { grid-template-columns: 11rem 1fr; } }
  .period { color: var(--muted); font-size: 0.9375rem; font-variant-numeric: tabular-nums; padding-top: 0.1rem; }
  .place { color: var(--muted); font-size: 0.9375rem; }
  .job-note { margin-top: 0.35rem; }

  .two { display: grid; gap: 0 4rem; max-width: 46rem; }
  @media (min-width: 40rem) { .two { grid-template-columns: 3fr 2fr; } }
  .plain { list-style: none; margin: 0; padding: 0; }
  .plain li + li { margin-top: 1.25rem; }
  .plain p { margin-top: 0.2rem; }
  .small { font-size: 0.9375rem; }
  .lang-table { border-collapse: collapse; width: 100%; }
  .lang-table th, .lang-table td { text-align: left; padding: 0.45rem 0; border-bottom: 1px solid var(--rule); }
  .lang-table th { font-weight: 500; }
  .lang-table td { color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
</style>
