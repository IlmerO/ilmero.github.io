---
import { getCollection } from 'astro:content';
import Lineage from './Lineage.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].home;

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---
<section>
  <h1>{t.h1}</h1>
  <p class="lead">{t.lead}</p>
  <Lineage steps={t.lineage} label={t.lineageLabel} />
</section>

<section class="section">
  <h2>{t.doingTitle}</h2>
  <dl class="doing">
    {t.doing.map((d) => (
      <div><dt>{d.t}</dt><dd>{d.d}</dd></div>
    ))}
  </dl>
</section>

{work.length > 0 && (
  <section class="section">
    <h2>{t.workTitle}</h2>
    <ul class="stories">
      {work.map((w) => (
        <li>
          <p class="kicker">{w.data.org}, {w.data.period}</p>
          <a class="story-title" href={`/work/${w.id}/`} hreflang="en">{w.data.title}</a>
          <p class="story-dek">{w.data.summary}</p>
        </li>
      ))}
    </ul>
    <a class="more" href="/work/">{t.workAll}</a>
  </section>
)}

{writing.length > 0 && (
  <section class="section">
    <h2>{t.writingTitle}</h2>
    <ul class="stories">
      {writing.map((p) => (
        <li>
          <p class="kicker"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></p>
          <a class="story-title" href={`/writing/${p.id}/`} hreflang="en">{p.data.title}</a>
          <p class="story-dek">{p.data.description}</p>
        </li>
      ))}
    </ul>
    <a class="more" href="/writing/">{t.writingAll}</a>
  </section>
)}

<style>
  h1 { max-width: 22ch; }
  .lead { margin-top: 1rem; max-width: var(--measure); font-size: 1.0625rem; }
  .doing { margin: 0; max-width: var(--measure); }
  .doing div + div { margin-top: 1rem; }
  .doing dt { font: 700 1.0625rem/1.3 var(--serif); }
  .doing dd { margin: 0.2rem 0 0; }
</style>
