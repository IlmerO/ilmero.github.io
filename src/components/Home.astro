---
import { getCollection } from 'astro:content';
import { ui, prefix, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].home;
const s = ui[lang].side;
const bio = ui[lang].about.bio;
// "The part of the job I like most is the one people tend to avoid: ..." -> first clause as the quote
const quote = bio[2].split(':')[0].trim();

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<div class="home">
  <div class="center">
    <article class="lead">
      <p class="kicker">Analytics Engineer</p>
      <h1>{t.h1}</h1>
      <p class="lead-dek">{t.lead}</p>
      <p class="in">{s.inWord} <a href={`${prefix(lang)}/about/`}>{ui[lang].nav.about}</a></p>
      <p class="dashes" aria-hidden="true">- - - - -</p>
    </article>

    <ul class="stories">
      {work.map((w) => (
        <li>
          <a class="story-title" href={`/work/${w.id}/`} hreflang="en">{w.data.title}</a>
          <p class="story-dek">{w.data.summary}</p>
          <p class="in">{s.inWord} <a href="/work/">{w.data.org}</a>, {w.data.period}</p>
        </li>
      ))}
      {writing.map((p) => (
        <li>
          <a class="story-title" href={`/writing/${p.id}/`} hreflang="en">{p.data.title}</a>
          <p class="story-dek">{p.data.description}</p>
          <p class="in">{s.inWord} <a href="/writing/">{ui[lang].nav.writing}</a>, {fmt.format(p.data.date)}</p>
        </li>
      ))}
    </ul>
    <a class="more" href="/work/">{t.workAll}</a>

    <section class="doing">
      <h2>{t.doingTitle}</h2>
      <dl>
        {t.doing.map((d) => (
          <div><dt>{d.t}</dt><dd>{d.d}</dd></div>
        ))}
      </dl>
    </section>
  </div>

  <aside class="right">
    <section>
      <h2 class="r-quote">{s.quote}</h2>
      <blockquote>"{quote}."</blockquote>
      <p class="attr">— Ilmer Oliveira</p>
    </section>

    <section>
      <h2 class="r-caps">{s.numbers}</h2>
      <ul class="numbers">
        {s.stats.map(([big, small]) => <li><b>{big}</b><span>{small}</span></li>)}
      </ul>
    </section>

    <section>
      <h2 class="r-caps">{s.meanwhile}</h2>
      <p>{bio[3]}</p>
    </section>
  </aside>
</div>

<style>
  .home { display: grid; gap: 2rem; }
  @media (min-width: 62rem) { .home { grid-template-columns: minmax(0, 1fr) 11.5rem; gap: 1.75rem; } }

  .lead { max-width: var(--measure); }
  .lead h1 { color: var(--teal); font-size: 1.5rem; line-height: 1.15; margin-top: 0.1rem; }
  .lead-dek { margin-top: 0.35rem; font-size: 0.8125rem; }

  .doing { margin-top: 2.25rem; max-width: var(--measure); }
  .doing h2 { color: var(--red-text); font-style: italic; font-size: 0.875rem; margin-bottom: 0.6rem; }
  .doing dl { margin: 0; }
  .doing div + div { margin-top: 0.9rem; }
  .doing dt { font-weight: 700; color: var(--teal); font-size: 0.875rem; }
  .doing dd { margin: 0.15rem 0 0; }

  .right { font-size: 0.6875rem; line-height: 1.45; }
  .right section + section { margin-top: 1.4rem; }
  .r-quote { color: var(--red-text); font-style: italic; font-weight: 400; font-size: 0.8125rem; }
  .right blockquote { margin: 0.3rem 0 0; font-weight: 700; font-size: 0.8125rem; line-height: 1.35; }
  .attr { margin-top: 0.3rem; }
  .r-caps { color: var(--red-text); text-transform: uppercase; font-size: 0.6875rem; margin-bottom: 0.4rem; }
  .numbers { list-style: none; margin: 0; padding: 0; }
  .numbers li + li { margin-top: 0.55rem; }
  .numbers b { display: block; color: var(--teal); font-size: 0.875rem; }
</style>
