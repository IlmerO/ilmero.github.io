---
import { getCollection } from 'astro:content';
import Lineage from './Lineage.astro';
import { ui, links, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].home;

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
---
<section class="hero">
  <h1>{t.h1}</h1>
  <p class="lead">{t.lead}</p>
  <Lineage steps={t.lineage} label={t.lineageLabel} />
</section>

<section class="section">
  <h2>{t.doingTitle}</h2>
  <dl class="doing">
    {t.doing.map((d) => (
      <div><dt>{d.t}</dt><dd>{d.d}</dd></div>
    ))}
  </dl>
</section>

{work.length > 0 && (
  <section class="section">
    <h2>{t.workTitle}</h2>
    <ul class="entries">
      {work.map((w) => (
        <li>
          <a href={`/work/${w.id}/`} hreflang="en">{w.data.title}</a>
          <p class="summary">{w.data.summary}</p>
          <p class="meta">{w.data.org}, {w.data.period}</p>
        </li>
      ))}
    </ul>
    <a class="more" href="/work/">{t.workAll}</a>
  </section>
)}

{writing.length > 0 && (
  <section class="section">
    <h2>{t.writingTitle}</h2>
    <ul class="entries">
      {writing.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`} hreflang="en">{p.data.title}</a>
          <p class="summary">{p.data.description}</p>
          <p class="meta"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></p>
        </li>
      ))}
    </ul>
    <a class="more" href="/writing/">{t.writingAll}</a>
  </section>
)}

<section class="section contact">
  <h2>{t.contactTitle}</h2>
  <p>{t.contact}</p>
  <p class="contact-links">
    <a href={links.linkedin}>linkedin.com/in/ilmer</a>
    <a href={links.github}>github.com/ilmero</a>
  </p>
</section>

<style>
  .hero { padding-top: clamp(3rem, 9vw, 6.5rem); }
  h1 { font-size: clamp(2.125rem, 5.4vw, 3.5rem); max-width: 19ch; }
  .lead { margin-top: 1.5rem; max-width: var(--measure); font-size: 1.1875rem; line-height: 1.55; color: var(--muted); }

  .doing { display: grid; gap: 1.75rem 2.5rem; margin: 0; max-width: 56rem; }
  @media (min-width: 48rem) { .doing { grid-template-columns: repeat(3, 1fr); } }
  .doing div { border-top: 2px solid var(--accent); padding-top: 0.85rem; }
  dt { font-weight: 600; font-size: 1.0625rem; }
  dd { margin: 0.4rem 0 0; color: var(--muted); }

  .contact p { max-width: var(--measure); }
  .contact-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; margin-top: 0.75rem; font-weight: 500; }
</style>
