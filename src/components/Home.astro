---
import { getCollection } from 'astro:content';
import Lineage from './Lineage.astro';
import { ui, links, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].home;

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const writing = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en', { year: 'numeric', month: 'short', day: 'numeric' });
---
<section class="hero">
  <h1>{t.h1}</h1>
  <p class="lead">{t.lead}</p>
  <Lineage steps={t.lineage} label={t.lineageLabel} />
</section>

<section class="section">
  <h2>{t.doingTitle}</h2>
  <div class="doing">
    {t.doing.map((d) => (
      <fieldset class="group"><legend>{d.t}</legend><p>{d.d}</p></fieldset>
    ))}
  </div>
</section>

{work.length > 0 && (
  <section class="section">
    <h2>{t.workTitle}</h2>
    <table class="details">
      <thead><tr><th scope="col">{t.cols.name}</th><th scope="col">{t.cols.company}</th><th scope="col">{t.cols.period}</th></tr></thead>
      <tbody>
        {work.map((w) => (
          <tr>
            <td><a class="title" href={`/work/${w.id}/`} hreflang="en">{w.data.title}</a><p class="sub">{w.data.summary}</p></td>
            <td class="nowrap">{w.data.org}</td>
            <td class="nowrap">{w.data.period}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="actions"><a class="btn" href="/work/">{t.workAll}</a></p>
  </section>
)}

{writing.length > 0 && (
  <section class="section">
    <h2>{t.writingTitle}</h2>
    <table class="details">
      <thead><tr><th scope="col">{t.cols.title}</th><th scope="col">{t.cols.date}</th></tr></thead>
      <tbody>
        {writing.map((p) => (
          <tr>
            <td><a class="title" href={`/writing/${p.id}/`} hreflang="en">{p.data.title}</a><p class="sub">{p.data.description}</p></td>
            <td class="nowrap"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="actions"><a class="btn" href="/writing/">{t.writingAll}</a></p>
  </section>
)}

<section class="section contact">
  <h2>{t.contactTitle}</h2>
  <p>{t.contact}</p>
  <p class="actions">
    <a class="btn" href={links.linkedin}>LinkedIn</a>
    <a class="btn" href={links.github}>GitHub</a>
  </p>
</section>

<style>
  .hero { padding-top: clamp(0.5rem, 3vw, 2rem); }
  h1 { max-width: 20ch; }
  .lead { margin-top: 1.25rem; max-width: var(--measure); font-size: 1.25rem; line-height: 1.45; }

  .doing { display: grid; gap: 1rem; max-width: 56rem; }
  @media (min-width: 48rem) { .doing { grid-template-columns: repeat(3, 1fr); } }
  .doing p { font-size: 1.0625rem; line-height: 1.45; }

  .contact > p:first-of-type { max-width: var(--measure); }
</style>
