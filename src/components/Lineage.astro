---
interface Props { steps: [string, string, string, string]; label: string }
const { steps, label } = Astro.props;
---
<figure class="lineage" role="img" aria-label={label}>
  <ol aria-hidden="true">
    {steps.map((s, i) => <li class={i === steps.length - 1 ? 'end' : undefined}><span class="dot"></span><span class="label">{s}</span></li>)}
  </ol>
</figure>

<style>
  .lineage { margin: 2.75rem 0 0; max-width: 46rem; }
  .lineage ol {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    position: relative;
  }
  /* the edge that connects the nodes, drawn once on load */
  .lineage ol::before {
    content: ''; position: absolute; top: 0.4375rem; left: 0.4375rem; right: calc(25% - 0.4375rem);
    height: 2px; background: var(--accent);
    transform-origin: left; animation: draw 1.4s cubic-bezier(.6, 0, .2, 1) 0.2s both;
  }
  .lineage li { position: relative; display: flex; flex-direction: column; gap: 0.6rem; padding-right: 1rem; }
  .lineage .dot {
    width: 0.875rem; height: 0.875rem; border-radius: 50%;
    border: 2px solid var(--accent); background: var(--paper); position: relative;
  }
  .lineage .label { font-size: 0.9375rem; color: var(--muted); line-height: 1.3; }
  .lineage .end .dot { background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .lineage .end .label { color: var(--ink); font-weight: 600; }
  .lineage li:nth-child(2) .dot { animation: on 0.2s ease-out 0.55s both; }
  .lineage li:nth-child(3) .dot { animation: on 0.2s ease-out 0.9s both; }
  .lineage li:nth-child(4) .dot { animation: on 0.3s ease-out 1.3s both; }

  @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes on { from { opacity: 0.2; } to { opacity: 1; } }

  @media (max-width: 34rem) {
    .lineage ol { grid-template-columns: 1fr; gap: 1rem; }
    .lineage ol::before { top: 0.4375rem; bottom: 0.4375rem; left: 0.375rem; right: auto; width: 2px; height: auto; transform-origin: top; animation-name: drawY; }
    .lineage li { flex-direction: row; align-items: center; gap: 0.9rem; }
    @keyframes drawY { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .lineage ol::before, .lineage .dot { animation: none !important; }
  }
</style>
