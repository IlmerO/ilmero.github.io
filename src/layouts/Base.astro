---
import '../styles/global.css';
import { ui, languages, prefix, pathFor, links, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** true for pages that exist in all four languages (adds hreflang links) */
  translated?: boolean;
}

const { title, description, lang = 'en', translated = false } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} | Ilmer Oliveira` : 'Ilmer Oliveira, Analytics Engineer';
const desc = description ?? t.meta.description;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const home = `${prefix(lang)}/`;
const atHome = path === home || path === home.replace(/\/$/, '');
const nav = [
  { href: home, label: t.nav.home, current: atHome },
  { href: `${prefix(lang)}/about/`, label: t.nav.about },
  { href: `/work/`, label: t.nav.work },
  { href: `/writing/`, label: t.nav.writing },
].map((n) => ({ ...n, current: n.current ?? path.startsWith(n.href) }));
const langCodes = Object.keys(languages) as Lang[];
const locale = { en: 'en-GB', pt: 'pt-BR', es: 'es-ES', de: 'de-DE' }[lang];
const now = new Date();
const updated = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(now);
const stack = ['dbt', 'BigQuery', 'Airflow', 'Python', 'SQL', 'Looker', 'AppSheets'];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {translated && langCodes.map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(pathFor(l, path), Astro.site)} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="Ilmer Oliveira, writing" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <header class="masthead">
        <a class="wordmark" href={home}>
          <svg class="mark" viewBox="0 0 16 16" width="32" height="32" aria-hidden="true" shape-rendering="crispEdges">
            <rect width="16" height="16" fill="#b0141b" />
            <g fill="#fff">
              <rect x="2" y="3" width="4" height="1" /><rect x="2" y="12" width="4" height="1" /><rect x="3" y="4" width="2" height="8" />
              <rect x="9" y="3" width="4" height="1" /><rect x="9" y="12" width="4" height="1" /><rect x="8" y="4" width="2" height="8" /><rect x="12" y="4" width="2" height="8" />
            </g>
          </svg>
          <span>Ilmer Oliveira</span>
        </a>
        <p class="tagline">{t.side.tagline}</p>
      </header>

      <nav class="tabs" aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="columns">
        <main id="main" class="main">
          <p class="dateline">{t.side.updated} {updated}</p>
          <slot />
        </main>

        <aside class="sidebar">
          <section>
            <h2>{t.home.contactTitle}</h2>
            <p>{t.home.contact}</p>
            <ul class="squares">
              <li><a href={links.linkedin}>LinkedIn</a></li>
              <li><a href={links.github}>GitHub</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </section>
          <section>
            <h2>{t.side.stack}</h2>
            <ul class="squares">
              {stack.map((s) => <li>{s}</li>)}
            </ul>
          </section>
          <section>
            <h2>{t.side.languages}</h2>
            <ul class="squares">
              {langCodes.map((l) => (
                <li>
                  {l === lang
                    ? <strong aria-current="true" lang={l}>{languages[l]}</strong>
                    : <a href={pathFor(l, path)} lang={l} hreflang={l}>{languages[l]}</a>}
                </li>
              ))}
            </ul>
            {t.footer.englishOnly && <p class="note">{t.footer.englishOnly}</p>}
          </section>
        </aside>
      </div>

      <footer class="colophon">
        <p>© {now.getFullYear()} Ilmer Oliveira. {t.side.built}</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .page { max-width: 60rem; margin: 0 auto; background: var(--paper); min-height: 100vh; display: flex; flex-direction: column; }
  @media (min-width: 48rem) {
    .page { margin: 1.75rem auto 2.5rem; min-height: 0; border: 1px solid #485553; box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.12); }
  }

  .masthead { padding: 1.25rem 1rem 1rem; }
  @media (min-width: 48rem) { .masthead { padding: 1.5rem 2rem 1.1rem; } }
  .wordmark {
    display: inline-flex; align-items: center; gap: 0.7rem;
    font: 700 1.875rem/1 var(--serif); letter-spacing: -0.01em;
    color: var(--ink); text-decoration: none;
  }
  .wordmark:visited { color: var(--ink); }
  .wordmark:hover { color: var(--red); }
  .mark { flex: none; width: 2rem; height: 2rem; }
  .tagline { margin-top: 0.5rem; font-size: 0.8125rem; color: var(--muted); }

  .tabs ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);
  }
  .tabs li + li { border-left: 1px solid var(--rule); }
  .tabs a {
    display: block; text-align: center; padding: 0.4rem 0.5rem;
    font-size: 0.8125rem; letter-spacing: 0.03em; text-transform: lowercase;
    color: var(--red); text-decoration: none;
  }
  .tabs a:hover { background: var(--band); color: var(--red); }
  .tabs a[aria-current='page'] { background: var(--red); color: #fff; font-weight: 700; }
  @media (max-width: 30rem) {
    .tabs ul { grid-template-columns: repeat(2, 1fr); }
    .tabs li:nth-child(3) { border-left: 0; }
    .tabs li:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }

  .columns { display: grid; flex: 1; }
  @media (min-width: 48rem) { .columns { grid-template-columns: minmax(0, 1fr) 13.5rem; } }

  .main { padding: 1.25rem 1rem 3rem; min-width: 0; }
  @media (min-width: 48rem) { .main { padding: 1.5rem 2rem 3.5rem; } }
  .dateline { font-size: 0.75rem; color: var(--muted); margin-bottom: 1.75rem; }

  .sidebar {
    background: var(--side); padding: 1.5rem 1rem;
    border-top: 1px dotted var(--muted);
    font-size: 0.8125rem; line-height: 1.5;
  }
  @media (min-width: 48rem) { .sidebar { border-top: 0; border-left: 1px dotted var(--muted); padding: 1.5rem 1.1rem 2rem; } }
  .sidebar section + section { margin-top: 1.75rem; }
  .sidebar h2 { font: 400 1.0625rem/1.2 var(--serif); margin-bottom: 0.5rem; }
  .sidebar p { margin-bottom: 0.6rem; }
  .sidebar .squares li + li { margin-top: 0.15rem; }
  .sidebar strong { font-weight: 700; }
  .note { margin-top: 0.6rem; color: var(--muted); font-style: italic; }

  .colophon { background: var(--band); border-top: 1px solid var(--rule); padding: 0.9rem 1rem; font-size: 0.75rem; color: var(--muted); }
  @media (min-width: 48rem) { .colophon { padding: 0.9rem 2rem; } }
</style>
