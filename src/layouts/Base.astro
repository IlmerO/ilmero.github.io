---
import '../styles/global.css';
import { ui, languages, prefix, pathFor, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  /** true for pages that exist in all four languages (adds hreflang links) */
  translated?: boolean;
}

const { title, description, lang = 'en', translated = false } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} | Ilmer Oliveira` : 'Ilmer Oliveira, Analytics Engineer';
const desc = description ?? t.meta.description;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const home = `${prefix(lang)}/`;
const nav = [
  { href: `/writing/`, label: t.nav.writing },
  { href: `/work/`, label: t.nav.work },
  { href: `${prefix(lang)}/about/`, label: t.nav.about },
];
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '') || (href !== home && path.startsWith(href));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {translated && (Object.keys(languages) as Lang[]).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(pathFor(l, path), Astro.site)} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="Ilmer Oliveira, writing" href="/rss.xml" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header frame">
      <a class="name" href={home}>Ilmer Oliveira</a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" class="frame">
      <slot />
    </main>

    <footer class="site-footer frame">
      <p class="links">
        <a href="https://www.linkedin.com/in/ilmer/">LinkedIn</a>
        <a href="https://github.com/ilmero">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </p>
      <nav class="langs" aria-label={t.footer.language}>
        {(Object.keys(languages) as Lang[]).map((l) =>
          l === lang ? (
            <span aria-current="true" lang={l}>{languages[l]}</span>
          ) : (
            <a href={pathFor(l, path)} lang={l} hreflang={l}>{languages[l]}</a>
          )
        )}
      </nav>
      {t.footer.englishOnly && <p class="note">{t.footer.englishOnly}</p>}
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .name { font-weight: 700; font-size: 1.0625rem; text-decoration: none; letter-spacing: -0.01em; }
  nav ul { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }

  .site-footer {
    margin-top: 6rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .links { display: flex; gap: 1.25rem; }
  .links a { color: var(--muted); }
  /* Language choice: deliberately quiet */
  .langs { display: flex; gap: 0.9rem; font-size: 0.8125rem; }
  .langs a { color: var(--muted); text-decoration: none; }
  .langs a:hover { color: var(--ink); text-decoration: underline; }
  .langs span { color: var(--ink); }
  .note { flex-basis: 100%; font-size: 0.8125rem; }
</style>
