---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="Writing" section="Writing" description="Notes on analytics engineering, financial data and cleaning up old warehouses.">
  <header class="page-head">
    <h1 class="visually-hidden">Writing</h1>
    <p class="dek">Notes on analytics engineering, financial data, and what it takes to clean up a warehouse nobody wants to touch.</p>
  </header>
  <p class="dashes" aria-hidden="true">- - - - -</p>
  {posts.length > 0 ? (
    <ul class="stories">
      {posts.map((p) => (
        <li>
          <a class="story-title" href={`/writing/${p.id}/`}>{p.data.title}</a>
          <p class="story-dek">{p.data.description}</p>
          <p class="in"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time></p>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty"><b>Coming soon.</b> The first articles are being written. Follow along by <a href="/rss.xml">RSS</a> or on <a href="https://www.linkedin.com/in/ilmer/">LinkedIn</a>.</p>
  )}
</Base>
<style>
  .empty { max-width: var(--measure); border: 2px solid var(--green-line); padding: 0.6rem 0.75rem; }
</style>
