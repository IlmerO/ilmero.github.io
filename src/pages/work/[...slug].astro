---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-head">
      <p class="kicker">{entry.data.org}, {entry.data.period}</p>
      <h1>{entry.data.title}</h1>
      <p class="dek">{entry.data.summary}</p>
    </header>
    <div class="prose body"><Content /></div>
    {entry.data.stack.length > 0 && (
      <p class="stack-line"><span>Stack:</span> {entry.data.stack.join(', ')}</p>
    )}
  </article>
  <a class="more back" href="/work/">All work</a>
</Base>
<style>
  .body { margin-top: 2rem; }
  .back { margin-top: 2rem; }
</style>
