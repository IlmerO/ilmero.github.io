---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', ({ data }) => !data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="page-head">
      <h1>{entry.data.title}</h1>
      <p class="muted">{entry.data.org}, {entry.data.period}</p>
    </header>
    <div class="prose body"><Content /></div>
    {entry.data.stack.length > 0 && (
      <fieldset class="group stack"><legend>Stack</legend>{entry.data.stack.join(', ')}</fieldset>
    )}
  </article>
  <p class="actions back"><a class="btn" href="/work/">All work</a></p>
</Base>
<style>
  .body { margin-top: 2rem; }
  .stack { margin-top: 2.5rem; max-width: var(--measure); font-family: var(--chrome); font-size: 0.9375rem; }
  .back { margin-top: 2.5rem; }
</style>
