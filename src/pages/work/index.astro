---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work" section="Work" description="Case studies from finance and product data teams: month-end close, warehouse costs, master data.">
  <header class="page-head">
    <h1 class="visually-hidden">Work</h1>
    <p class="dek">Short case studies from the teams I've worked with. Client data stays out; the problem, what changed and the result stay in.</p>
  </header>
  <p class="dashes" aria-hidden="true">- - - - -</p>
  <ul class="stories">
    {work.map((w) => (
      <li>
        <a class="story-title" href={`/work/${w.id}/`}>{w.data.title}</a>
        <p class="story-dek">{w.data.summary}</p>
        <p class="in">in {w.data.org}, {w.data.period}</p>
      </li>
    ))}
  </ul>
</Base>
