---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const work = (await getCollection('work', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work" description="Case studies from finance and product data teams: month-end close, warehouse costs, master data.">
  <header class="page-head">
    <h1>Work</h1>
    <p>Short case studies from the teams I've worked with. Client data stays out; the problem, what changed and the result stay in.</p>
  </header>
  <table class="details list">
    <thead><tr><th scope="col">Name</th><th scope="col">Company</th><th scope="col">Period</th></tr></thead>
    <tbody>
      {work.map((w) => (
        <tr>
          <td><a class="title" href={`/work/${w.id}/`}>{w.data.title}</a><p class="sub">{w.data.summary}</p></td>
          <td class="nowrap">{w.data.org}</td>
          <td class="nowrap">{w.data.period}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
<style>
  .list { margin-top: 2rem; }
</style>
